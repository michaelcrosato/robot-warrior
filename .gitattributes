# Normalise line endings in the repository; check out native on Windows.
* text=auto eol=lf

*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binary assets — never diff, never touch line endings.
*.mp3  binary
*.ogg  binary
*.wav  binary
*.png  binary
*.jpg  binary
*.ico  binary
*.woff binary
*.woff2 binary

# Generated / vendored files are collapsed in diffs and excluded from language stats.
pnpm-lock.yaml linguist-generated=true -diff
assets/audio/**  linguist-vendored=true
